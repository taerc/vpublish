# VPublish 配置文件模板
# 复制为 config.yaml 并修改实际值

server:
  port: 8080
  mode: release          # debug | release
  read_timeout: 30s
  write_timeout: 30s

database:
  host: 127.0.0.1
  port: 3306
  user: root
  password: ""           # 请修改为实际密码
  dbname: vpublish
  max_open_conns: 100
  max_idle_conns: 10

jwt:
  secret: ""             # 请修改为安全的随机字符串
  expire: 24h
  refresh_expire: 168h

storage:
  type: local
  path: ./uploads
  max_file_size: 104857600  # 100MB
  external_download_url_prefix: ""  # 如 http://cdn.example.com/uploads

log:
  level: info            # debug | info | warn | error

mcp:
  http:
    enabled: true
    host: 127.0.0.1
    port: 8081
    endpoint_path: /mcp
  auth:
    app_key: ""          # MCP App Key
    app_secret: ""       # MCP App Secret
